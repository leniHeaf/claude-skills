{
  "name": "VehicleEvent",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "Fahrzeug-ID"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Fahrzeuginfo"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "status_change",
        "photo_added",
        "task_created",
        "task_done",
        "quality_check",
        "note_added",
        "handover"
      ],
      "description": "Ereignistyp"
    },
    "from_status": {
      "type": "string",
      "description": "Vorheriger Status"
    },
    "to_status": {
      "type": "string",
      "description": "Neuer Status"
    },
    "actor": {
      "type": "string",
      "description": "Wer hat die Aktion ausgef\u00fchrt"
    },
    "note": {
      "type": "string",
      "description": "Notiz"
    }
  },
  "required": [
    "vehicle_id",
    "event_type"
  ]
}