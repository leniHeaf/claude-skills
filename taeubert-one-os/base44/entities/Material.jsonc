{
  "name": "Material",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Produktname"
    },
    "category": {
      "type": "string",
      "enum": [
        "karosserie",
        "vorbereitung",
        "lackierung",
        "finish",
        "aufbereitung",
        "reinigung",
        "schutz",
        "sonstiges"
      ],
      "default": "sonstiges"
    },
    "supplier_main": {
      "type": "string",
      "description": "Hauptlieferant"
    },
    "supplier_alt": {
      "type": "string",
      "description": "Ersatzlieferant"
    },
    "article_number": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "description": "Einheit z.B. Stk, Liter, Rolle"
    },
    "price_per_unit": {
      "type": "number"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "description": "Mindestbestand \u2192 Nachbestellgrenze"
    },
    "preferred_order_qty": {
      "type": "number",
      "description": "Bevorzugte Bestellmenge"
    },
    "lead_time_days": {
      "type": "number",
      "description": "Lieferzeit in Tagen"
    },
    "last_ordered": {
      "type": "string",
      "format": "date"
    },
    "photo": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}