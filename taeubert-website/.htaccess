RewriteRule ^pages/fragen/?$ /fragen.html [R=301,L]
RewriteRule ^pages/konfigurator/?$ /konfigurator.html [R=301,L]
RewriteRule ^pages/karriere/?$ /karriere.html [R=301,L]
RewriteRule ^pages/bamberg/?$ /bamberg.html [R=301,L]
RewriteRule ^pages/boxenstopp/?$ /boxenstopp.html [R=301,L]
RewriteRule ^pages/fahrzeugaufbereitung/?$ /fahrzeugaufbereitung.html [R=301,L]
