RewriteRule ^pages/reifenservice/?$ /reifenservice.html [R=301,L]
RewriteRule ^pages/roedental/?$ /roedental.html [R=301,L]
RewriteRule ^pages/smartrepair/?$ /smartrepair.html [R=301,L]
RewriteRule ^pages/sonneberg/?$ /sonneberg.html [R=301,L]
RewriteRule ^pages/unfall/?$ /unfall.html [R=301,L]
RewriteRule ^pages/unfall\-oder\-kratzer/?$ /unfall-oder-kratzer.html [R=301,L]
