# IONOS / Apache – erzeugt von build_pages.py
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Immer HTTPS und mit www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.taeubert\-karosserie\-lack\.de$ [NC]
RewriteRule ^(.*)$ https://www.taeubert-karosserie-lack.de/$1 [R=301,L]
# Alte Shopify-Adressen
RewriteRule ^pages/contact/?$ /contact.html [R=301,L]
RewriteRule ^pages/who\-we\-are/?$ /who-we-are.html [R=301,L]
RewriteRule ^pages/jobs/?$ /jobs.html [R=301,L]
RewriteRule ^pages/26\-09\-2026\-boxenstopp/?$ /boxenstopp.html [R=301,L]
RewriteRule ^pages/history/?$ /history.html [R=301,L]
